<idea-plugin>
  <id>dev.rsandtner.lombok-config-fix</id>
  <name>Lombok config from disk</name>
  <version>0.1</version>
  <vendor>local</vendor>
  <depends>com.intellij.java</depends>
  <depends>Lombook Plugin</depends>
  <extensions defaultExtensionNs="com.intellij">
    <applicationService serviceInterface="de.plushnikov.intellij.plugin.lombokconfig.ConfigDiscovery"
                        serviceImplementation="dev.rsandtner.lombokcfg.DiskConfigDiscovery"
                        overrides="true"/>
  </extensions>
</idea-plugin>
